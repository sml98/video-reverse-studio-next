{
  "$defs": {
    "SceneAnchor": {
      "additionalProperties": false,
      "properties": {
        "word": {
          "default": "",
          "maxLength": 80,
          "title": "Word",
          "type": "string"
        },
        "occurrence": {
          "default": 1,
          "maximum": 2000,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "spanWords": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Spanwords",
          "type": "integer"
        },
        "wordId": {
          "default": "",
          "maxLength": 64,
          "title": "Wordid",
          "type": "string"
        },
        "effect": {
          "default": "highlight",
          "enum": [
            "highlight",
            "zoom_punch",
            "sticker_pop",
            "broll_overlay",
            "badge_flash",
            "camera_shake"
          ],
          "title": "Effect",
          "type": "string"
        },
        "asset": {
          "default": "",
          "maxLength": 400,
          "title": "Asset",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 160,
          "title": "Label",
          "type": "string"
        },
        "sfx": {
          "default": "",
          "maxLength": 400,
          "title": "Sfx",
          "type": "string"
        }
      },
      "title": "SceneAnchor",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "maxLength": 400,
          "title": "Claim",
          "type": "string"
        },
        "source": {
          "maxLength": 400,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "claim",
        "source"
      ],
      "title": "Source",
      "type": "object"
    },
    "StoryboardScene": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "default": "",
          "maxLength": 80,
          "title": "Role",
          "type": "string"
        },
        "title": {
          "default": "",
          "maxLength": 160,
          "title": "Title",
          "type": "string"
        },
        "sfx": {
          "default": "",
          "maxLength": 400,
          "title": "Sfx",
          "type": "string"
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/SceneAnchor"
          },
          "maxItems": 24,
          "title": "Anchors",
          "type": "array"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "preset_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Preset Id",
          "type": "string"
        },
        "parameters_json": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters Json"
        },
        "parameters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters"
        },
        "narration": {
          "default": "",
          "maxLength": 2000,
          "title": "Narration",
          "type": "string"
        },
        "voice": {
          "default": "",
          "maxLength": 40,
          "title": "Voice",
          "type": "string"
        },
        "asset_path": {
          "default": "",
          "maxLength": 400,
          "title": "Asset Path",
          "type": "string"
        },
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Asset Ids",
          "type": "array"
        },
        "duration": {
          "default": 5,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Duration",
          "type": "number"
        },
        "transition": {
          "anyOf": [
            {
              "enum": [
                "none",
                "fade",
                "wipe",
                "slide",
                "zoom",
                "circle",
                "flash"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transition"
        }
      },
      "required": [
        "preset_id"
      ],
      "title": "StoryboardScene",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "nicheId": {
      "default": "",
      "maxLength": 80,
      "title": "Nicheid",
      "type": "string"
    },
    "aspect": {
      "default": "",
      "enum": [
        "",
        "vertical",
        "landscape",
        "square"
      ],
      "title": "Aspect",
      "type": "string"
    },
    "voice": {
      "default": "",
      "maxLength": 40,
      "title": "Voice",
      "type": "string"
    },
    "captions": {
      "default": "",
      "maxLength": 20,
      "title": "Captions",
      "type": "string"
    },
    "theme": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Theme"
    },
    "style_mix": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Style Mix"
    },
    "schema": {
      "const": "vrs.storyboard/1",
      "default": "vrs.storyboard/1",
      "title": "Schema",
      "type": "string"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "language": {
      "default": "pt-BR",
      "maxLength": 16,
      "title": "Language",
      "type": "string"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Uncertainties",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "maxItems": 40,
      "title": "Sources",
      "type": "array"
    },
    "illustrative_data": {
      "default": false,
      "title": "Illustrative Data",
      "type": "boolean"
    },
    "music": {
      "default": "",
      "maxLength": 400,
      "title": "Music",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/StoryboardScene"
      },
      "maxItems": 60,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    }
  },
  "required": [
    "title",
    "scenes"
  ],
  "title": "Storyboard",
  "type": "object"
}