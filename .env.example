# Configuração local do Video Reverse Studio (somente loopback)
VRS_HOST=127.0.0.1
VRS_PORT=8765
VRS_THREADS=2
VRS_RENDER_CONCURRENCY=1
VRS_DEFAULT_VOICE=faber
VRS_ASR_MODEL=whisper-tiny

# Sogni (opcional — desabilitado por padrão; somente assinatura Unlimited, zero créditos)
VRS_SOGNI_ENABLED=false
VRS_SOGNI_BILLING_MODE=unlimited_subscription_only
VRS_SOGNI_ALLOW_CREDITS=false
VRS_SOGNI_LAUNCHER_SHA256=
