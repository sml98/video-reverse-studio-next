{
  "version": 1,
  "icons": ["sun", "planet", "heat", "cold", "arrow", "coin", "chart", "person", "house", "leaf", "drop", "flame", "gear", "idea", "check", "warning", "clock", "globe", "pumpkin", "ghost", "candle", "book", "star", "heart", "moon", "bolt", "rocket", "atom"],
