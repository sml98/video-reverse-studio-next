        {"key": "conclusion", "type": "text", "label": "Conclusão", "maxLength": 100, "default": ""},
        {"key": "illustrative", "type": "boolean", "label": "Dados ilustrativos", "default": true}
      ]
    },
    {
      "id": "vrs-comparison",
