        {"key": "style", "type": "select", "label": "Estilo", "options": ["cinematic", "bold", "minimal"], "default": "cinematic"},
        {"key": "backgroundAsset", "type": "asset", "label": "Imagem de fundo (opcional)", "default": ""}
