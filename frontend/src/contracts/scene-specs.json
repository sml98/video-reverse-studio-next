      "summary": "Eixo surge, barras crescem com contadores e a barra destacada pulsa; dados ilustrativos são marcados.",
      "category": "dados",
      "motion": ["barras crescendo", "contadores", "destaque"],
      "params": [
        {"key": "title", "type": "text", "label": "Título", "maxLength": 80, "default": "Comparação"},
        {"key": "unit", "type": "text", "label": "Unidade", "maxLength": 12, "default": ""},
        {"key": "bars", "type": "list", "label": "Barras", "maxItems": 8, "minItems": 1,
          "item": {"type": "object", "fields": [
            {"key": "label", "type": "text", "label": "Rótulo", "maxLength": 24, "default": "A"},
            {"key": "value", "type": "number", "label": "Valor", "min": -1000000000, "max": 1000000000, "default": 10},
            {"key": "highlight", "type": "boolean", "label": "Destacar", "default": false}
          ]},
          "default": [{"label": "A", "value": 30, "highlight": false}, {"label": "B", "value": 60, "highlight": true}, {"label": "C", "value": 45, "highlight": false}]
        },
        {"key": "note", "type": "text", "label": "Nota/fonte", "maxLength": 120, "default": ""},
        {"key": "illustrative", "type": "boolean", "label": "Dados ilustrativos", "default": true}
      ]
    },
    {
      "id": "vrs-line-chart",
      "title": "Gráfico de linha desenhado",
      "summary": "Grade e eixos aparecem, a linha se desenha ponto a ponto, área preenche e uma anotação aponta o momento-chave.",
      "category": "dados",
      "motion": ["linha desenhada", "área", "anotação"],
      "params": [
        {"key": "title", "type": "text", "label": "Título", "maxLength": 80, "default": "Evolução"},
        {"key": "unit", "type": "text", "label": "Unidade", "maxLength": 12, "default": ""},
        {"key": "points", "type": "list", "label": "Pontos", "maxItems": 24, "minItems": 2,
          "item": {"type": "object", "fields": [
            {"key": "label", "type": "text", "label": "Rótulo", "maxLength": 12, "default": "1"},
            {"key": "value", "type": "number", "label": "Valor", "min": -1000000000, "max": 1000000000, "default": 0}
          ]},
          "default": [{"label": "1", "value": 10}, {"label": "2", "value": 14}, {"label": "3", "value": 22}, {"label": "4", "value": 35}]
        },
        {"key": "annotationIndex", "type": "number", "label": "Ponto anotado (índice, -1 = nenhum)", "min": -1, "max": 23, "default": -1},
        {"key": "annotationText", "type": "text", "label": "Texto da anotação", "maxLength": 60, "default": ""},
        {"key": "illustrative", "type": "boolean", "label": "Dados ilustrativos", "default": true}
      ]
    },
    {
      "id": "vrs-calc",
      "title": "Cálculo passo a passo",
      "summary": "Cada linha do cálculo entra, o resultado conta até o valor e a conclusão fecha com destaque.",
      "category": "dados",
      "motion": ["contadores", "revelação por etapa"],
      "params": [
        {"key": "title", "type": "text", "label": "Título", "maxLength": 80, "default": "Exemplo numérico"},
        {"key": "steps", "type": "list", "label": "Etapas", "maxItems": 6, "minItems": 1,
          "item": {"type": "object", "fields": [
            {"key": "label", "type": "text", "label": "Rótulo", "maxLength": 50, "default": "Etapa"},
            {"key": "expression", "type": "text", "label": "Expressão", "maxLength": 60, "default": ""},
            {"key": "result", "type": "number", "label": "Resultado", "min": -1000000000000, "max": 1000000000000, "default": 0},
            {"key": "prefix", "type": "text", "label": "Prefixo", "maxLength": 6, "default": ""},
            {"key": "suffix", "type": "text", "label": "Sufixo", "maxLength": 8, "default": ""},
            {"key": "decimals", "type": "number", "label": "Casas decimais", "min": 0, "max": 4, "default": 0}
          ]},
          "default": [{"label": "Valor inicial", "expression": "", "result": 1000, "prefix": "R$ ", "suffix": "", "decimals": 2}]
