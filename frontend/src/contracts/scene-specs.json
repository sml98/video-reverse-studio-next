    {
      "id": "vrs-title",
      "title": "Título de capítulo animado",
      "summary": "Rótulo cresce, linha se desenha, palavras do título entram em sequência; fundo com partículas lentas.",
      "category": "titulos",
      "motion": ["texto cinético", "linha desenhada", "partículas"],
      "params": [
        {"key": "label", "type": "text", "label": "Rótulo/capítulo", "maxLength": 40, "default": "CAPÍTULO 1"},
        {"key": "title", "type": "text", "label": "Título", "maxLength": 90, "default": "Uma pergunta simples"},
        {"key": "subtitle", "type": "text", "label": "Subtítulo", "maxLength": 140, "default": ""},
        {"key": "style", "type": "select", "label": "Estilo", "options": ["cinematic", "bold", "minimal"], "default": "cinematic"},
        {"key": "backgroundAsset", "type": "asset", "label": "Imagem de fundo (opcional)", "default": ""}
      ]
    },
    {
      "id": "vrs-kinetic-quote",
      "title": "Frase tipográfica animada",
      "summary": "Composição tipográfica com grupos de palavras, ênfases coloridas, pausas legíveis e assinatura opcional honesta.",
      "category": "frases",
      "motion": ["texto cinético", "ênfase", "pausa de leitura"],
      "params": [
        {"key": "text", "type": "longtext", "label": "Frase", "maxLength": 280, "default": "Disciplina é lembrar o que você quer."},
        {"key": "emphasis", "type": "text", "label": "Palavras de ênfase (separadas por vírgula)", "maxLength": 200, "default": "disciplina"},
        {"key": "author", "type": "text", "label": "Assinatura (vazio = sem atribuição)", "maxLength": 80, "default": ""},
        {"key": "authorship", "type": "select", "label": "Autoria", "options": ["autoral", "citacao_verificada", "sem_atribuicao"], "default": "autoral"},
        {"key": "style", "type": "select", "label": "Estilo", "options": ["elegant", "impact", "minimal", "neon"], "default": "elegant"}
      ]
    },
    {
      "id": "vrs-timeline",
      "title": "Linha do tempo progressiva",
      "summary": "Linha avança, marcadores surgem em ordem e cada evento revela ano, rótulo e detalhe.",
      "category": "documentario",
      "motion": ["progresso", "revelação sequencial", "marcadores"],
      "params": [
        {"key": "title", "type": "text", "label": "Título", "maxLength": 80, "default": "Linha do tempo"},
        {"key": "events", "type": "list", "label": "Eventos", "maxItems": 6, "minItems": 2,
          "item": {"type": "object", "fields": [
            {"key": "year", "type": "text", "label": "Data", "maxLength": 18, "default": "1900"},
            {"key": "label", "type": "text", "label": "Evento", "maxLength": 40, "default": "Evento"},
            {"key": "detail", "type": "text", "label": "Detalhe", "maxLength": 90, "default": ""}
          ]},
          "default": [{"year": "1800", "label": "Início", "detail": ""}, {"year": "1900", "label": "Mudança", "detail": ""}, {"year": "2000", "label": "Hoje", "detail": ""}]
        }
      ]
    },
    {
      "id": "vrs-mechanism",
      "title": "Diagrama de mecanismo",
      "summary": "Nós aparecem, setas se desenham e partículas percorrem os fluxos mostrando causa → efeito.",
      "category": "ciencia",
      "motion": ["fluxo", "setas desenhadas", "partículas no caminho"],
      "params": [
        {"key": "title", "type": "text", "label": "Título", "maxLength": 80, "default": "Como funciona"},
        {"key": "nodes", "type": "list", "label": "Etapas/nós", "maxItems": 6, "minItems": 2,
          "item": {"type": "object", "fields": [
            {"key": "id", "type": "text", "label": "ID", "maxLength": 20, "default": "a"},
            {"key": "label", "type": "text", "label": "Rótulo", "maxLength": 30, "default": "Etapa"},
            {"key": "icon", "type": "icon", "label": "Ícone", "default": "gear"}
          ]},
          "default": [{"id": "a", "label": "Causa", "icon": "sun"}, {"id": "b", "label": "Processo", "icon": "gear"}, {"id": "c", "label": "Efeito", "icon": "arrow"}]
        },
        {"key": "edges", "type": "list", "label": "Ligações", "maxItems": 8,
          "item": {"type": "object", "fields": [
            {"key": "from", "type": "text", "label": "De", "maxLength": 20, "default": "a"},
            {"key": "to", "type": "text", "label": "Para", "maxLength": 20, "default": "b"},
            {"key": "label", "type": "text", "label": "Rótulo", "maxLength": 30, "default": ""}
          ]},
          "default": [{"from": "a", "to": "b", "label": ""}, {"from": "b", "to": "c", "label": ""}]
