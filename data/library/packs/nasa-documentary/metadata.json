{"QuickTime:ModifyDate": "2015:07:24 20:21:32", "Composite:Rotation": 0, "AVAIL:Center": "GSFC", "QuickTime:MovieDataSize": 88510487, "QuickTime:AudioBitsPerSample": 16, "File:FilePermissions": "rw-------", "QuickTime:TimeScale": 30000, "File:FileModifyDate": "2019:03:06 18:30:01+00:00", "File:FileSize": "84 MB", "QuickTime:ImageHeight": 720, "AVAIL:Owner": "sasnodgr", "QuickTime:YResolution": 72, "QuickTime:TrackLayer": 0, "QuickTime:ImageWidth": 1280, "QuickTime:CleanApertureDimensions": "1280x720", "QuickTime:SelectionDuration": "0 s", "QuickTime:VideoFrameRate": 29.97, "QuickTime:SourceImageHeight": 720, "QuickTime:SourceImageWidth": 1280, "QuickTime:PreviewDuration": "0 s", "QuickTime:MovieDataOffset": 16, "QuickTime:MovieHeaderVersion": 0, "QuickTime:XResolution": 72, "QuickTime:MediaTimeScale": 48000, "QuickTime:OpColor": "32768 32768 32768", "QuickTime:AudioFormat": "mp4a", "AVAIL:Location": "Goddard Space Flight Center", "File:FileTypeExtension": "mov", "AVAIL:Creator": null, "QuickTime:EncodedPixelsDimensions": "1280x720", "SourceFile": "/tmp/tmp88odiirn", "QuickTime:PreferredVolume": "100.00%", "QuickTime:MatrixStructure": "1 0 0 0 1 0 0 0 1", "QuickTime:Duration": "0:02:03", "QuickTime:PurchaseFileFormat": "mp4a", "AVAIL:Description": "Near-Earth asteroids like Bennu pose a potential danger to our planet, so it's important to predict their orbits with great accuracy. Unfortunately, a phenomenon called the Yarkovsky effect can make these predictions difficult over long time periods. How does this effect work?\nWhen sunlight strikes a rotating asteroid, the dayside heats up; as the asteroid turns, the night side cools and releases the heat, exerting a small thrust that can change the asteroid's direction over time. In order to learn more about this process on asteroid Bennu, NASA is sending a spacecraft called OSIRIS-REx to make detailed observations of Bennu's shape, brightness, and surface features. These factors are thought to influence the Yarkovsky effect, and understanding how will enable scientists to better predict the orbit of Bennu and other near-Earth asteroids.", "AVAIL:Description508": "Rotating asteroids have a tough time sticking to their orbits. Their surfaces heat up during the day and cool down at night, giving off radiation that can act as a sort of mini-thruster. This force, called the Yarkovsky effect, can cause rotating asteroids to drift widely over time, making it hard for scientists to predict their long-term risk to Earth.", "AVAIL:Album": "OSIRIS-REx", "QuickTime:TrackID": 1, "File:Directory": "/tmp", "QuickTime:TrackVolume": "100.00%", "AVAIL:NASAID": "GSFC_20150729_Yarkovsky_m11964_Effect", "Composite:Megapixels": 0.922, "File:FileName": "tmp88odiirn", "AVAIL:Keywords": ["Asteroid", "Radiation", "Rotating", "OSIRIS-REx", "Sun", "Near-Earth Object", "Yarkovsky Effect", "Bennu"], "AVAIL:Photographer": "", "AVAIL:SecondaryCreator": "Dan Gallagher, Chris Smith", "QuickTime:HandlerVendorID": "Apple", "AVAIL:Thumbnails": {"small": ["https://images-assets.nasa.gov/video/GSFC_20150729_Yarkovsky_m11964_Effect/GSFC_20150729_Yarkovsky_m11964_Effect~small_1.jpg", "https://images-assets.nasa.gov/video/GSFC_20150729_Yarkovsky_m11964_Effect/GSFC_20150729_Yarkovsky_m11964_Effect~small_2.jpg", "https://images-assets.nasa.gov/video/GSFC_20150729_Yarkovsky_m11964_Effect/GSFC_20150729_Yarkovsky_m11964_Effect~small_3.jpg", "https://images-assets.nasa.gov/video/GSFC_20150729_Yarkovsky_m11964_Effect/GSFC_20150729_Yarkovsky_m11964_Effect~small_4.jpg", "https://images-assets.nasa.gov/video/GSFC_20150729_Yarkovsky_m11964_Effect/GSFC_20150729_Yarkovsky_m11964_Effect~small_5.jpg"], "large": ["https://images-assets.nasa.gov/video/GSFC_20150729_Yarkovsky_m11964_Effect/GSFC_20150729_Yarkovsky_m11964_Effect~large_1.jpg", "https://images-assets.nasa.gov/video/GSFC_20150729_Yarkovsky_m11964_Effect/GSFC_20150729_Yarkovsky_m11964_Effect~large_2.jpg", "https://images-assets.nasa.gov/video/GSFC_20150729_Yarkovsky_m11964_Effec